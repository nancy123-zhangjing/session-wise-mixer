+def expected_parameters(model, phase):
+    if phase == "tokenizer":
+        return {"joint_alignment.mixer.base_codebooks"}
+    return {name for name, _ in model.named_parameters()
+            if not name.startswith(("joint_alignment.", "joint_sequence_adapter."))}
+
