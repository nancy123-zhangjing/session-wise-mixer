+        need(isinstance(value, dict), f"Config layer is not a mapping: {layer}")
+        config.update(value)
+    for key, value in list(config.items()):
+        if isinstance(value, str):
+            if value.lower() in ("true", "false"):
+                config[key] = value.lower() == "true"
+            else:
