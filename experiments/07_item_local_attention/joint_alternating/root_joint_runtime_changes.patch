+            with lock:
+                console.write(message); console.flush()
+                try: sys.stdout.write(message); sys.stdout.flush()
+                except (BrokenPipeError, OSError): pass
+
+        def stream(label, child):
+            for line in child.stdout: emit(label, line)
+            child.stdout.close()
+
