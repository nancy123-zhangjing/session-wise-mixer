{
  "protocol_id": "kuairec_five_item_diffgrm_full_mixer_v1",
  "architecture": "H",
  "seed": 2024,
  "list_length": 5,
  "history_max": 50,
  "dataset": "outputs/kuairec_listwise_v1/run1",
  "assets": "outputs/kuairec_listwise_assets_v1",
  "model": {
    "n_digit": 4,
    "codebook_size": 256,
    "encoder_n_layer": 1,
    "decoder_n_layer": 4,
    "n_embd": 256,
    "n_head": 4,
    "n_inner": 1024,
    "dropout": 0.1,
    "attn_pdrop": 0.1,
    "resid_pdrop": 0.1,
    "norm_type": "layernorm",
    "norm_eps": 1e-05,
    "share_decoder_output_embedding": true,
    "masking_strategy": "guided",
    "guided_steps": 4,
    "guided_conf_metric": "msp",
    "guided_select": "least",
    "guided_refresh_each_step": false,
    "diffusion_loss_reduction": "per_view",
    "label_smoothing": 0.2,
    "item_local_attention": {
      "enabled": false
    },
    "dedup_strategy": "simple",
    "current_split": "val",
    "h_prefix_mode": "cross_attention"
  },
  "alignment": {
    "crosspse_heads": 4,
    "crosspse_dropout": 0.0,
    "crosspse_attention_scope": "full",
    "crosspse_residual_scale_init": 1.0,
    "crosspse_learn_residual_scale": false,
    "crosspse_zero_init_attention_output": true,
    "crosspse_train_base_codebooks": true,
    "joint_gradient_mode": "diger_st",
    "joint_diger_assignment_temperature": 0.1,
    "joint_diger_softmax_temperature_start": 1.0,
    "joint_diger_softmax_temperature_end": 1.0,
    "joint_diger_gumbel_noise_start": 1.0,
    "joint_diger_gumbel_noise_end": 0.2,
    "joint_diger_uncertainty_decay": "cosine"
  },
  "training": {
    "deterministic_algorithms": true,
    "effective_batch_size": 1024,
    "microbatch_size": 256,
    "warmup_epochs": 5,
    "cycles": 10,
    "r_epochs_per_cycle": 3,
    "t_updates_per_cycle": 40,
    "checkpoint_every_updates": 100,
    "decoder_lr": 0.001,
    "decoder_warmup_updates": 500,
    "decoder_weight_decay": 0.0,
    "codebook_lr": 1e-05,
    "mixer_lr": 0.0001,
    "tokenizer_weight_decay": 0.0001,
    "adam_betas": [
      0.9,
      0.999
    ],
    "adam_eps": 1e-08,
    "recommendation_weight": 1.0,
    "reconstruction_weight": 1.0,
    "balance_weight": 0.01,
    "anchor_weight": 0.01,
    "balance_temperature": 0.1,
    "sia_weight": 0.0,
    "max_grad_norm": 1.0
  },
  "evaluation": {
    "val_beam": 32,
    "test_beam": 32,
    "candidate_lists": 32,
    "batch_size": 4,
    "selection": "ndcg@5",
    "tie_break": "earlier",
    "aggregate_ks": [
      10,
      20,
      50
    ],
    "sensitivity_beam": 256,
    "filter_history": false,
    "collision_rule": "reconstruction_error_then_original_id",
    "aggregation": "list_score_order_then_item_position_first_occurrence"
  },
  "provenance": "docs/research/onerec_listwise/IMPLEMENTATION_REFERENCES.md",
  "execution": {
    "optimized_io": true,
    "optimized_model_checks": true
  }
}
