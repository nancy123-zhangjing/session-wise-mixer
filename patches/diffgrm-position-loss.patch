+            if len(semantic_id) != self.semantic_n_digit:
+                raise ValueError(
+                    f'Item {item!r} has {len(semantic_id)} semantic digits; '
+                    f'expected {self.semantic_n_digit}.'
+                )
+            if any(code < 0 or code >= self.codebook_size for code in semantic_id):
+                raise ValueError(
+                    f'Item {item!r} has out-of-range semantic code {semantic_id}; '
+                    f'expected every code in [0, {self.codebook_size - 1}].'
+                )
+            semantic_groups[semantic_id].append(item)
+
+        group_sizes = [len(items) for items in semantic_groups.values()]
+        collided_items = sum(size for size in group_sizes if size > 1)
+        colliding_groups = sum(size > 1 for size in group_sizes)
+        largest_group = max(group_sizes, default=0)
+        self.semantic_collision_stats = {
+            'items': len(item2sem_ids),
+            'unique_semantic_ids': len(semantic_groups),
+            'collided_items': collided_items,
+            'colliding_groups': colliding_groups,
+            'collision_rate': collided_items / max(len(item2sem_ids), 1),
+            'largest_collision_group': largest_group,
+        }
+        self.log(
+            '[SID_UNIQUENESS] Semantic SID: '
+            f'{len(semantic_groups)}/{len(item2sem_ids)} unique, '
+            f'{collided_items} collided items '
+            f'({self.semantic_collision_stats["collision_rate"]:.4%}), '
+            f'largest group={largest_group}'
+        )
+
+        if self.use_collision_suffix and largest_group > self.codebook_size:
+            raise ValueError(
+                f'Largest semantic-ID collision group has {largest_group} items, '
+                f'but collision suffix only supports {self.codebook_size} values.'
+            )
+
+        item_to_suffix = {}
+        for items in semantic_groups.values():
+            # JSON insertion order follows internal item order, making the
+            # assignment deterministic for a fixed dataset and quantizer seed.
+            for suffix, item in enumerate(items):
+                item_to_suffix[item] = suffix
